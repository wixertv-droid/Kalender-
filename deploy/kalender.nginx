# Ausschließlich kalender.bytevo.de – andere vhosts unangetastet.
# Erst nach Ausstellung des Let's Encrypt-Zertifikats und der Geräte-CA aktivieren.
server {
    listen 80;
    listen [::]:80;
    server_name kalender.bytevo.de;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kalender.bytevo.de;

    ssl_certificate /etc/letsencrypt/live/kalender.bytevo.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kalender.bytevo.de/privkey.pem;

    ssl_client_certificate /etc/nginx/kalender/client-ca.crt;
    ssl_verify_client on;
    ssl_verify_depth 1;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 10m;
    access_log /var/log/nginx/kalender.access.log;
    error_log /var/log/nginx/kalender.error.log;

    location / {
        proxy_pass http://127.0.0.1:3102;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Kalender-Verified $ssl_client_verify;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
